---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 mx-auto max-w-4xl w-full px-6 py-24">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-2 text-[1.0625rem] text-muted-foreground leading-relaxed">
        Build durable, provider-neutral agent systems in Java.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <a
          href="/start-here/quickstart"
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Start here</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Build your first agent</div>
        </a>
        <a
          href="/chat/overview"
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Chat</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Model and tool loops</div>
        </a>
        <a
          href="/graph/overview"
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Graph</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Durable orchestration</div>
        </a>
      </div>
      <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <a href="/deep-agent/overview" class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline">
          <div class="font-medium text-foreground">Deep Agent</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Workspaces, approvals, and subagents</div>
        </a>
        <a href="/architecture/overview" class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline">
          <div class="font-medium text-foreground">Architecture</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Composable modules, explicit boundaries</div>
        </a>
      </div>
    </main>
  </div>
</BaseLayout>
