---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { Tabs, TabItem } from "../components/ui/tabs";
import { config } from "virtual:nimbus/config";
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex min-h-screen flex-col overflow-hidden">
    <Header showSidebar={false} />
    <main id="main-content" class="flex-1">
      <section class="relative isolate overflow-hidden border-b border-border">
        <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-[32rem] bg-[radial-gradient(ellipse_at_top,oklch(0.83_0.11_255_/_0.24),transparent_65%)] dark:bg-[radial-gradient(ellipse_at_top,oklch(0.48_0.13_255_/_0.24),transparent_65%)]"></div>
        <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-28">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/8 px-3 py-1.5 text-xs font-semibold text-primary">
              <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
              Durable agent systems for the JVM
            </div>
            <div class="mt-7 flex items-center gap-4">
              <img src="/branding/cortavyn-icon.svg" width="104" height="56" alt="Cortavyn" class="h-14 w-[6.5rem]" />
              <h1 class="text-5xl font-semibold tracking-[-0.045em] text-foreground sm:text-6xl">Cortavyn</h1>
            </div>
            <p class="mt-6 max-w-2xl text-xl leading-relaxed text-muted-foreground sm:text-2xl">
              Build dependable AI systems with portable models, durable orchestration, and agents that can safely do real work.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/start-here/quickstart" class="rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground no-underline shadow-sm transition-transform hover:-translate-y-0.5 hover:bg-primary-hover">Build your first agent</a>
              <a href="/architecture/overview" class="rounded-lg border border-border bg-card/70 px-5 py-3 text-sm font-semibold text-foreground no-underline transition-colors hover:border-border-strong hover:bg-card">Explore the architecture</a>
            </div>
            <div class="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-sm text-muted-foreground">
              <span><strong class="text-foreground">Java 25</strong> foundation</span>
              <span><strong class="text-foreground">Provider-neutral</strong> contracts</span>
              <span><strong class="text-foreground">Apache-2.0</strong> licensed</span>
            </div>
          </div>

          <div class="relative rounded-2xl border border-border bg-card/80 p-5 shadow-lg backdrop-blur">
            <div class="flex items-center justify-between border-b border-border pb-4">
              <div class="flex items-center gap-2 text-sm font-semibold text-foreground">
                <span class="flex h-7 w-7 items-center justify-center rounded-md bg-primary/10 text-primary">∞</span>
                Your agent stack
              </div>
              <span class="rounded-full bg-success-muted px-2.5 py-1 text-xs font-semibold text-success">Durable</span>
            </div>
            <div class="space-y-3 py-5 text-sm">
              <div class="flex items-center justify-between rounded-lg border border-border bg-background/70 p-3"><span class="font-medium text-foreground">Model and tool loop</span><span class="text-muted-foreground">Chat</span></div>
              <div class="flex items-center justify-between rounded-lg border border-border bg-background/70 p-3"><span class="font-medium text-foreground">State, routes, checkpoints</span><span class="text-muted-foreground">Graph</span></div>
              <div class="flex items-center justify-between rounded-lg border border-border bg-background/70 p-3"><span class="font-medium text-foreground">Workspace and approvals</span><span class="text-muted-foreground">Deep Agent</span></div>
            </div>
            <div class="rounded-lg bg-muted px-4 py-3 font-mono text-xs text-muted-foreground">
              <span class="text-primary">run</span> → checkpoint → review → resume
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-6 py-20">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary">Choose a capability</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-foreground">Start small. Compose as you grow.</h2>
          <p class="mt-3 text-lg leading-relaxed text-muted-foreground">Pick the layer that matches today’s problem. Each works independently and combines cleanly when your system needs more.</p>
        </div>

        <Tabs syncKey="cortavyn-capability" class="mt-10 max-w-4xl">
          <TabItem label="Chat">
            <div class="grid gap-6 rounded-xl border border-border bg-card p-7 md:grid-cols-[1fr_auto] md:items-center">
              <div>
                <p class="text-sm font-semibold text-primary">Chat</p>
                <h3 class="mt-2 text-2xl font-semibold text-foreground">Portable conversation and tool loops.</h3>
                <p class="mt-3 leading-relaxed text-muted-foreground">Keep messages, models, tools, structured output, and progress signals independent of any provider protocol.</p>
              </div>
              <a href="/chat/overview" class="rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary-hover">Explore Chat</a>
            </div>
          </TabItem>
          <TabItem label="Graph">
            <div class="grid gap-6 rounded-xl border border-border bg-card p-7 md:grid-cols-[1fr_auto] md:items-center">
              <div>
                <p class="text-sm font-semibold text-primary">Graph</p>
                <h3 class="mt-2 text-2xl font-semibold text-foreground">Stateful workflows that survive interruption.</h3>
                <p class="mt-3 leading-relaxed text-muted-foreground">Route work, run concurrent nodes, persist checkpoints, stream progress, and resume the same thread with explicit caller-owned state.</p>
              </div>
              <a href="/graph/overview" class="rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary-hover">Explore Graph</a>
            </div>
          </TabItem>
          <TabItem label="Deep Agent">
            <div class="grid gap-6 rounded-xl border border-border bg-card p-7 md:grid-cols-[1fr_auto] md:items-center">
              <div>
                <p class="text-sm font-semibold text-primary">Deep Agent</p>
                <h3 class="mt-2 text-2xl font-semibold text-foreground">Agents with workspaces, plans, and human control.</h3>
                <p class="mt-3 leading-relaxed text-muted-foreground">Give a model an isolated workspace, task planning, skills, subagents, and approval-aware actions without giving up durability.</p>
              </div>
              <a href="/deep-agent/overview" class="rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary-hover">Explore Deep Agent</a>
            </div>
          </TabItem>
        </Tabs>
      </section>

      <section class="border-y border-border bg-muted/45">
        <div class="mx-auto grid max-w-6xl gap-5 px-6 py-16 md:grid-cols-3">
          <a href="/start-here/overview" class="rounded-xl border border-border bg-card p-6 no-underline transition-transform hover:-translate-y-1 hover:shadow-lg">
            <p class="text-sm font-semibold text-primary">01</p><h3 class="mt-3 text-lg font-semibold text-foreground">Start here</h3><p class="mt-2 leading-relaxed text-sm text-muted-foreground">Install, choose artifacts, and run an example.</p>
          </a>
          <a href="/providers/overview" class="rounded-xl border border-border bg-card p-6 no-underline transition-transform hover:-translate-y-1 hover:shadow-lg">
            <p class="text-sm font-semibold text-primary">02</p><h3 class="mt-3 text-lg font-semibold text-foreground">Connect a provider</h3><p class="mt-2 leading-relaxed text-sm text-muted-foreground">Keep application code portable at the model boundary.</p>
          </a>
          <a href="/reference/artifacts" class="rounded-xl border border-border bg-card p-6 no-underline transition-transform hover:-translate-y-1 hover:shadow-lg">
            <p class="text-sm font-semibold text-primary">03</p><h3 class="mt-3 text-lg font-semibold text-foreground">Find the API</h3><p class="mt-2 leading-relaxed text-sm text-muted-foreground">Browse artifacts, examples, and operational guidance.</p>
          </a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
